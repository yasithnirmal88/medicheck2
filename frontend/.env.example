VITE_FIREBASE_AUTH_DOMAIN=medicheck-19865.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=medicheck-19865
VITE_FIREBASE_STORAGE_BUCKET=medicheck-19865.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=873643749135
