# ===========================================
# Medicheck Backend - Production Environment
# ===========================================
# Copy this file to .env and fill in the values

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Security - REQUIRED: Generate a strong random key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-here-generate-with-python-command

# Database (Render PostgreSQL will set this automatically)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Redis (Render Redis will set this automatically)
# REDIS_URL=redis://:password@host:6379/0

# Firebase Configuration (Required for production)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Include the private key with newline characters escaped
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# CORS Configuration - Update with your Vercel domain
CORS_ORIGINS=https://your-frontend.vercel.app,https://*.vercel.app,http://localhost:3000,http://localhost:5173

# Allowed Hosts - Update with your Render domain
ALLOWED_HOSTS=your-backend.onrender.com,.onrender.com

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Security Headers
ENABLE_SECURITY_HEADERS=true

# Disable mock auth in production
ALLOW_MOCK_AUTH=false

# HSTS Max Age (seconds) - 1 year
HSTS_MAX_AGE=31536000

# API Version
API_V1_PREFIX=/api/v1

# Project
PROJECT_NAME=MediCheck
VERSION=0.1.0
