# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
# Log format: text (default) or json (log aggregation).
LOG_FORMAT=text
# API docs (/docs, /redoc, /openapi.json). Empty = auto (on except production).
DOCS_ENABLED=
# Sentry error tracking. Empty = disabled (requires sentry-sdk installed).
SENTRY_DSN=
SECRET_KEY=change-me-to-a-random-secret-key
PROJECT_NAME=MediCheck
VERSION=0.1.0
API_V1_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=medicheck
POSTGRES_PASSWORD=your-strong-password
POSTGRES_DB=medicheck
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Firebase Auth ───────────────────────────────────────────
# Provide either a path (mounted file) or inline JSON
# FIREBASE_CREDENTIALS_PATH=/etc/medicheck/firebase-credentials.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AI Explanation (Phase 1) ───────────────────────────────
# Provider: "stub" (default, deterministic, no external API),
# "personalized-stub" (multilingual + literacy levels, still local), or
# "openai" / "openai-compatible" (real HTTP provider — requires AI_API_KEY
# + AI_MODEL; missing credentials fail fast instead of using the stub).
# AI is an explanation layer ONLY and never alters the deterministic
# clinical result.
AI_PROVIDER=stub
AI_MODEL=
AI_API_KEY=
# Base URL for OpenAI-compatible chat APIs. Empty = OpenAI default
# (https://api.openai.com/v1). Azure native endpoint shape is NOT supported.
AI_BASE_URL=
# Retries after the first attempt for transient vendor failures (429/5xx).
AI_MAX_RETRIES=1
# Vendor spend guardrails (metered/real providers only; stubs bypass).
# Per-user hourly + daily and global daily request budgets (0 = tier off).
AI_BUDGET_USER_HOURLY_REQUESTS=30
AI_BUDGET_USER_DAILY_REQUESTS=200
AI_BUDGET_GLOBAL_DAILY_REQUESTS=20000
# Phase 2 RAG (structured retrieval over approved evidence; no vector DB)
AI_RAG_EVIDENCE_LIMIT=5
AI_RAG_PER_ENTITY_CAP=2
AI_RAG_EXCERPT_MAX_CHARS=500

# ── Voice AI Clinical Intake (Phase 5) ─────────────────────────────
# STT provider: "stub" (default, deterministic placeholder transcript) or
# "openai" / "whisper" / "openai-compatible" (real HTTP transcription —
# requires STT_API_KEY; model defaults to whisper-1).
STT_PROVIDER=stub
STT_MODEL=
STT_API_KEY=
# Base URL for OpenAI-compatible transcription APIs. Empty = OpenAI default.
STT_BASE_URL=

# ── AI operations ──────────────────────────────────────────────────
# CHW queue ranking provider. Only "stub" is implemented (deterministic
# local ranking, operational factors only). Any other value fails fast.
CHW_QUEUE_PROVIDER=stub
