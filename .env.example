# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
SECRET_KEY=change-me-to-a-random-secret-key
PROJECT_NAME=MediCheck
VERSION=0.1.0
API_V1_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=medicheck
POSTGRES_PASSWORD=your-strong-password
POSTGRES_DB=medicheck
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Firebase Auth ───────────────────────────────────────────
# Provide either a path (mounted file) or inline JSON
# FIREBASE_CREDENTIALS_PATH=/etc/medicheck/firebase-credentials.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AI Explanation (Phase 1) ───────────────────────────────
# Provider: "stub" (default, deterministic, no external API) or a vendor
# identifier once a real provider is wired in. AI is an explanation layer
# ONLY and never alters the deterministic clinical result.
AI_PROVIDER=stub
AI_MODEL=
AI_API_KEY=
# Phase 2 RAG (structured retrieval over approved evidence; no vector DB)
AI_RAG_EVIDENCE_LIMIT=5
AI_RAG_PER_ENTITY_CAP=2
AI_RAG_EXCERPT_MAX_CHARS=500
